# APP_URL: The URL where this applet is hosted (e.g. https://sekolahaikita.my.id).
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Optional backend origin if frontend is hosted statically on a separate domain.
VITE_API_BASE_URL=""

# RESEND_API_KEY: Server-side API key for Resend automatic email notifications.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SAKITA <no-reply@sekolahaikita.my.id>"

# FONNTE_TOKEN: Server-side token for Fonnte automatic WhatsApp notifications (recommended in Indonesia).
FONNTE_TOKEN=""

# WHATSAPP_API_TOKEN: Alternative Meta WhatsApp Business Cloud API access token.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# COMMUNITY_WHATSAPP_LINK: Optional fallback WhatsApp community invite link (prefer configuring via Admin Dashboard).
COMMUNITY_WHATSAPP_LINK=""

# INITIAL_ADMIN_EMAIL: Primary administrator Google email address.
INITIAL_ADMIN_EMAIL="ahmadmahbubi@gmail.com"
